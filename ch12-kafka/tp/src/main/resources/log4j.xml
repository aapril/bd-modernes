<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd" >
<log4j:configuration debug="false">
    <!--Console appender -->
    <appender name="stdout" class="org.apache.log4j.ConsoleAppender">
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="%d{yyyy-MM-dd HH:mm:ss} %-5p [%t] %c - %m%n"/>
        </layout>
    </appender>

    <logger name="org.apache.kafka" additivity="false">
        <level value="WARN"/>
        <appender-ref ref="stdout"/>
    </logger>

    <logger name="org.apache.kafka.common.metrics" additivity="false">
        <level value="WARN"/>
        <appender-ref ref="stdout"/>
    </logger>

    <logger name="org.apache.kafka.common.utils.AppInfoParser" additivity="false">
        <level value="WARN"/>
        <appender-ref ref="stdout"/>
    </logger>

    <logger name="org.apache.kafka.common.config.AbstractConfig" additivity="false">
        <level value="WARN"/>
        <appender-ref ref="stdout"/>
    </logger>

    <root>
        <level value="INFO"/>
        <appender-ref ref="stdout"/>
    </root>
</log4j:configuration>